`timescale 1ns / 1ps
//
// Self-checking loopback testbench for uart_tx + uart_rx.
// Ties tx -> rx directly and checks:
//   1) every FSM state in both TX and RX (S_IDLE/S_START/S_DATA/S_STOP) is visited
//   2) each transmitted frame carries exactly 10 bit periods (1 start + 8 data + 1 stop)
//   3) each bit period matches 1/BAUD_RATE, measured in real time against CLKS_PER_BIT
//   4) data received over rx matches the data sent over tx
//
module tb_uart_simplex ();

    localparam integer CLK_FREQ = 100_000_000;
    localparam integer BAUD_RATE = 115_200;
    localparam integer CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;  // 868
    localparam real CLK_PERIOD_NS = 10.0;  // 100 MHz
    localparam real    BIT_PERIOD_NS = CLKS_PER_BIT * CLK_PERIOD_NS;  // 8680 ns (~115,207 bps)
    localparam real TOL_NS = CLK_PERIOD_NS;  // +/- 1 clock tolerance

    logic       clk;
    logic       reset;

    logic       tx_start;
    logic [7:0] tx_data;
    logic       tx_busy;
    logic       tx_done;
    logic       tx_line;

    logic [7:0] rx_data;
    logic       rx_done;

    // ---------------------------------------------------------------
    // DUTs, looped back tx -> rx
    // ---------------------------------------------------------------
    uart_tx #(
        .CLK_FREQ (CLK_FREQ),
        .BAUD_RATE(BAUD_RATE)
    ) u_tx (
        .clk     (clk),
        .reset   (reset),
        .tx_start(tx_start),
        .tx_data (tx_data),
        .tx_busy (tx_busy),
        .tx_done (tx_done),
        .tx      (tx_line)
    );

    uart_rx #(
        .CLK_FREQ (CLK_FREQ),
        .BAUD_RATE(BAUD_RATE)
    ) u_rx (
        .clk    (clk),
        .reset  (reset),
        .rx     (tx_line),
        .rx_data(rx_data),
        .rx_done(rx_done)
    );

    // ---------------------------------------------------------------
    // clock: 100 MHz
    // ---------------------------------------------------------------
    initial clk = 1'b0;
    always #(CLK_PERIOD_NS / 2) clk = ~clk;

    // ---------------------------------------------------------------
    // FSM state coverage (accessed hierarchically, sim-only)
    // index: 0=S_IDLE 1=S_START 2=S_DATA 3=S_STOP
    // ---------------------------------------------------------------
    bit tx_seen[4];
    bit rx_seen[4];

    always @(posedge clk) begin
        if (!reset) begin
            tx_seen[u_tx.state] = 1'b1;
            rx_seen[u_rx.state] = 1'b1;
        end
    end

    // ---------------------------------------------------------------
    // bit-period measurement on the tx line.
    // u_tx.clk_cnt hits CLKS_PER_BIT-1 once per bit (start, 8x data, stop)
    // -> exactly 10 pulses per byte.
    // ---------------------------------------------------------------
    int bit_count;
    real t_prev, t_now, period;
    int errors;

    always @(posedge clk) begin
        if (!reset && u_tx.clk_cnt == CLKS_PER_BIT - 1) begin
            t_now = $realtime;
            if (bit_count > 0) begin
                period = t_now - t_prev;
                if (period < BIT_PERIOD_NS - TOL_NS || period > BIT_PERIOD_NS + TOL_NS) begin
                    $error(
                        "[%0t] bit period out of spec: got %0.1f ns, expected %0.1f ns (115,200 baud)",
                        $time, period, BIT_PERIOD_NS);
                    errors++;
                end
            end
            t_prev = t_now;
            bit_count++;
        end
    end

    // ---------------------------------------------------------------
    // watchdog so a stuck DUT doesn't hang the sim
    // ---------------------------------------------------------------
    initial begin
        #5_000_000;  // 5 ms
        $error("TESTBENCH TIMEOUT");
        $finish;
    end

    // ---------------------------------------------------------------
    // test sequence
    // ---------------------------------------------------------------
    logic [7:0] test_vectors[6] = '{8'h00, 8'hFF, 8'h55, 8'hAA, 8'h3C, 8'hA5};
    int frames_checked;

    task automatic send_byte(input [7:0] data);
        begin
            bit_count = 0;

            @(posedge clk);
            tx_data  <= data;
            tx_start <= 1'b1;
            @(posedge clk);
            tx_start <= 1'b0;


            @(posedge rx_done);
            if (rx_data !== data) begin
                $error("loopback mismatch: sent 0x%0h, received 0x%0h", data,
                       rx_data);
                errors++;
            end else begin
                $display(
                    "[%0t] OK: sent 0x%0h, received 0x%0h (%0d bit periods, ~%0.1f ns/bit)",
                    $time, data, rx_data, bit_count, BIT_PERIOD_NS);
            end
            @(posedge tx_done);
            if (bit_count !== 10) begin
                $error("frame for 0x%0h had %0d bit periods, expected 10",
                       data, bit_count);
                errors++;
            end
            frames_checked++;
        end
    endtask

    initial begin
        reset          = 1'b1;
        tx_start       = 1'b0;
        tx_data        = 8'h00;
        bit_count      = 0;
        errors         = 0;
        frames_checked = 0;

        repeat (5) @(posedge clk);
        reset = 1'b0;
        repeat (5) @(posedge clk);

        foreach (test_vectors[i]) begin
            send_byte(test_vectors[i]);
            repeat (10) @(posedge clk);  // idle gap between frames
        end

        $display("---------------------------------------------");
        $display("TX state coverage: IDLE=%0d START=%0d DATA=%0d STOP=%0d",
                 tx_seen[0], tx_seen[1], tx_seen[2], tx_seen[3]);
        $display("RX state coverage: IDLE=%0d START=%0d DATA=%0d STOP=%0d",
                 rx_seen[0], rx_seen[1], rx_seen[2], rx_seen[3]);
        if (!(tx_seen[0] && tx_seen[1] && tx_seen[2] && tx_seen[3])) begin
            $error("TX FSM did not visit every state");
            errors++;
        end
        if (!(rx_seen[0] && rx_seen[1] && rx_seen[2] && rx_seen[3])) begin
            $error("RX FSM did not visit every state");
            errors++;
        end

        $display("---------------------------------------------");
        if (errors == 0)
            $display("ALL TESTS PASSED (%0d frames checked)", frames_checked);
        else
            $display(
                "TEST FAILED: %0d error(s) across %0d frames",
                errors,
                frames_checked
            );
        $display("---------------------------------------------");

        $finish;
    end

endmodule
